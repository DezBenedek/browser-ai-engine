{
  "name": "browser-ai-engine",
  "version": "0.1.0",
  "description": "Offline-first LLM + STT/TTS engine for the browser. WebGPU inference via WebLLM, audio via Transformers.js, tool calling with Zod validation.",
  "type": "module",
  "license": "MIT",
  "author": "browser-ai-engine contributors",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/adapters/react.js",
      "require": "./dist/adapters/react.cjs"
    },
    "./svelte": {
      "types": "./dist/adapters/svelte.d.ts",
      "import": "./dist/adapters/svelte.js",
      "require": "./dist/adapters/svelte.cjs"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/adapters/vue.js",
      "require": "./dist/adapters/vue.cjs"
    },
    "./solid": {
      "types": "./dist/adapters/solid.d.ts",
      "import": "./dist/adapters/solid.js",
      "require": "./dist/adapters/solid.cjs"
    },
    "./angular": {
      "types": "./dist/adapters/angular.d.ts",
      "import": "./dist/adapters/angular.js",
      "require": "./dist/adapters/angular.cjs"
    },
    "./store": {
      "types": "./dist/adapters/store.d.ts",
      "import": "./dist/adapters/store.js",
      "require": "./dist/adapters/store.cjs"
    },
    "./webcomponent": {
      "types": "./dist/adapters/webcomponent.d.ts",
      "import": "./dist/adapters/webcomponent.js"
    },
    "./widget.css": "./dist/widget.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "node -e \"const{copyFileSync,mkdirSync}=require('fs');mkdirSync('dist',{recursive:true});copyFileSync('src/ui/widget.css','dist/widget.css')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.79",
    "@xenova/transformers": "^2.17.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@angular/core": "^18.2.14",
    "@types/react": "^18.3.3",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.15",
    "svelte": "^4.2.18",
    "tsup": "^8.1.0",
    "typescript": "^5.5.4",
    "vitepress": "^1.3.4",
    "vitest": "^2.1.3",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3",
    "solid-js": ">=1",
    "@angular/core": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "keywords": [
    "browser-ai",
    "webgpu",
    "webllm",
    "llm",
    "stt",
    "tts",
    "offline",
    "rag",
    "tool-calling"
  ],
  "engines": {
    "node": ">=20"
  }
}
